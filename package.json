{
  "name": "enterprise-agent-factory-service-website",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=22"
  },
  "scripts": {
    "build": "bun run --filter '@afs/sdk' build && bun run --filter '@afs/console' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "audit": "bun audit --prod --audit-level=high",
    "gate": "bun install --frozen-lockfile && bun run contract:check && bun run codegen:check && bun run lint && bun run typecheck && bun run test:cover && bun run build",
    "contract:check": "bun run --filter '@afs/sdk' contract:check",
    "test:cover": "bun run --filter '*' test:cover",
    "codegen:check": "bun run --filter '@afs/sdk' codegen:check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
