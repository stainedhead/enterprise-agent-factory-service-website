{
  "name": "@afs/console",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:cover": "vitest run --coverage",
    "size": "bun tools/size-console.ts",
    "e2e": "playwright test",
    "e2e:dev": "E2E_DEV=1 playwright test --project=dev",
    "e2e:report": "bun e2e/visual/report.ts",
    "docs:screenshots": "AFS_DOCS_SCREENSHOTS=../../docs/images/screenshots playwright test --project=chromium --trace off"
  },
  "dependencies": {
    "@afs/sdk": "workspace:*",
    "@tanstack/react-query": "5.108.2",
    "oauth4webapi": "3.8.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "axe-core": "4.14.1",
    "happy-dom": "21.0.4",
    "vite": "8.3.8",
    "yaml": "2.9.1"
  }
}
